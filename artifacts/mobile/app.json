{
  "expo": {
    "name": "Wistoria",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wistoria.app"
    },
    "android": {
      "package": "com.wistoria.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wistoria to access your photos to redesign your rooms.",
          "cameraPermission": "Allow Wistoria to use your camera to take photos of your rooms."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Wistoria to save redesigned room photos to your library.",
          "savePhotosPermission": "Allow Wistoria to save redesigned room photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
